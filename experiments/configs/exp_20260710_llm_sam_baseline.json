{
  "experiment_id": "exp_20260710_llm_sam_baseline",
  "description": "LLM+SAM基线实验 - 使用GLM-4V进行主体定位，SAM进行精细分割",
  "date": "2026-07-10",
  "author": "researcher",
  
  "dataset": {
    "name": "test_samples",
    "path": "data/test_samples/",
    "images": ["钟鼓楼.png", "zgc.png", "水倒影.png"]
  },
  
  "model": {
    "type": "llm_sam",
    "llm_model": "glm-4.6v",
    "sam_model": "sam_vit_b",
    "device": "cuda"
  },
  
  "parameters": {
    "sam_mask_threshold": 0.5
  },
  
  "ablation": {
    "enabled": false
  },
  
  "output": {
    "base_dir": "outputs/sam/",
    "experiment_dir": "exp_20260710_llm_sam_baseline",
    "save_masks": true,
    "save_visualizations": true,
    "save_metrics": true
  },
  
  "evaluation": {
    "metrics": ["bbox_accuracy", "mask_quality"]
  }
}